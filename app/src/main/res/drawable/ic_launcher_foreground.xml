<?xml version="1.0" encoding="utf-8"?>
<!--
  Open-book silhouette. Two pages splay from a bottom binding with a V-gap
  opening upward. Detail is carried by SHAPE, not colour, and there are no
  hairline strokes — so it reads correctly both in full colour and when
  Android flattens the <monochrome> layer to a single tint (themed icons).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left page -->
    <path
        android:fillColor="#F2ECFF"
        android:pathData="M50,40 C40,38 32,40 26,45 L27,60 C36,63 46,65 54,66 C53,56 52,48 50,40 Z" />
    <!-- Right page (mirror; transparent V-gap forms the spine) -->
    <path
        android:fillColor="#F2ECFF"
        android:pathData="M58,40 C68,38 76,40 82,45 L81,60 C72,63 62,65 54,66 C55,56 56,48 58,40 Z" />
</vector>
