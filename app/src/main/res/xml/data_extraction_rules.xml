<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer from Android 12. Widget ids are device specific, so the list
     of widgets this install has seen stays on the device (see WidgetConfig.dropForeign). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="widget_local.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="widget_local.xml" />
    </device-transfer>
</data-extraction-rules>
